# Copy to .env to override the compose defaults. Every default is a local-development value only.
POSTGRES_PASSWORD=postgres-dev-only
MIGRATOR_PASSWORD=migrator-dev-only
APP_PASSWORD=app-dev-only
ADMIN_KEY=admin-dev-only
POSTGRES_PORT=58743
API_PORT=58744
# Optional: a personal TCMB EVDS key enables `"source": "evds"` on POST /api/v1/admin/ingest.
EVDS_API_KEY=
# Optional: OTLP endpoint, e.g. http://aspire-dashboard:18889 with `--profile observability`.
OTEL_EXPORTER_OTLP_ENDPOINT=
