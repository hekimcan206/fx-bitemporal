{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Extensions.Http": "Warning",
        "Polly": "Warning",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Store": {
    "Consistency": "Fenced"
  },
  "Sources": {
    "Default": "fixture"
  },
  "Admin": {
    "Key": ""
  },
  "OpenApi": {
    "Enabled": false
  },
  "Database": {
    "MigrateOnStartup": false
  }
}
